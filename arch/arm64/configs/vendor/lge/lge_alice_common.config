CONFIG_MACH_MSM8996_H1=y
# CONFIG_LGE_USES_NEW_FPC_BLOBS is not set

# G5 touch, USB and notification hardware.
CONFIG_LGE_TOUCH_LGSIC_LG4946=y
CONFIG_LGE_USB_ANX7418=y
CONFIG_LEDS_PMI8996_EMOTIONAL=y

# G5 has no ESS headphone DAC or tertiary Bluetooth audio backend.
# CONFIG_SND_USE_TERT_MI2S is not set
