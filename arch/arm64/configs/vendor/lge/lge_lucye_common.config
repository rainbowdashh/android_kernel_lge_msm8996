CONFIG_MACH_MSM8996_LUCYE=y
# CONFIG_BACKLIGHT_LCD_SUPPORT is not set

# G6 wireless integration; each model selects its Broadcom chip.
CONFIG_BCMDHD_PREALLOC_PKTIDMAP=y
CONFIG_BCMDHD_HOSTAPD_BGN_MODE=y

# G6 touch and Type-C controllers.
CONFIG_LGE_TOUCH_LGSIC_SW49408=y
CONFIG_LGE_USB_TUSB422=y
CONFIG_LGE_USB_TUSB422_PAL=y

# G6 headphone DAC.
CONFIG_SND_SOC_ES9218P=y
