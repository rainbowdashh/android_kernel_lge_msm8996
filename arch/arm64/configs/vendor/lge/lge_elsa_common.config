CONFIG_MACH_MSM8996_ELSA=y
# CONFIG_MACH_MSM8996_LUCYE is not set
# CONFIG_MACH_MSM8996_H1 is not set
# CONFIG_DIRTYSANTA_FIXUP_G6 is not set
# CONFIG_LGE_USES_NEW_FPC_BLOBS is not set
CONFIG_LGE_TOUCH_CORE=y
CONFIG_LGE_TOUCH_LGSIC_LG4945=y
CONFIG_LGE_TOUCH_LGSIC_SW49407=y
# CONFIG_LGE_TOUCH_LGSIC_SW49408 is not set
CONFIG_BACKLIGHT_CLASS_DEVICE=y
CONFIG_BACKLIGHT_LM3697=y
CONFIG_SND_SOC_ES9018=y
CONFIG_SND_USE_TERT_MI2S=y
# CONFIG_SND_SOC_ES9218P is not set
CONFIG_LGE_USB_TYPE_C=y
CONFIG_LGE_USB_ANX7688=y
CONFIG_LGE_USB_ANX7688_OVP=y
CONFIG_DUAL_ROLE_USB_INTF=y
# CONFIG_TUSB422 is not set
# CONFIG_TUSB422_PAL is not set
CONFIG_BCMDHD=y
CONFIG_BCMDHD_PCIE=y
CONFIG_BCMDHD_COB=y
CONFIG_BCMDHD_FW_PATH="/vendor/firmware/fw_bcmdhd.bin"
CONFIG_BCMDHD_NVRAM_PATH="/vendor/etc/wifi/bcmdhd.cal"
CONFIG_LGE_BCM433X_PATCH=y
CONFIG_BROADCOM_WIFI_RESERVED_MEM=y
CONFIG_BCMDHD_USE_SCHED_SCAN=y
CONFIG_SERIAL_MSM_HS_BRCMBT=y
CONFIG_BT_BCM43XX=y
CONFIG_BT_MSM_SLEEP=y
CONFIG_LG_OIS=y
CONFIG_LEDS_QPNP_HAPTICS=y

CONFIG_LGE_IRRC=y
CONFIG_BACKLIGHT_PARTIAL_MODE_SUPPORTED=y
CONFIG_LC898123F40=y
CONFIG_LG_PROXY=y

CONFIG_LGE_DP_ANX7688=y
