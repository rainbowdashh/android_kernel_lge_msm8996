&pm8994_mpps {
	default-state {
/* Must not define the mpps(mpp 1 and 3) on here */
	mpp2 {
			bias-high-impedance;
			status = "okay";
		};

	mpp4 {
			bias-high-impedance;
			status = "okay";
		};

	mpp5 {
			function = "digital";
			qcom,dtest = <0>;
			qcom,paired = <0>;
			power-source = <2>;
			input-enable = <0>;
			output-enable = <1>;
			/delete-property/ output-low;
			/delete-property/ output-high;
			output-low;
			/delete-property/ bias-high-impedance;
			status = "okay";
		};

	mpp6 {
			function = "digital";
			qcom,dtest = <0>;
			qcom,paired = <0>;
			power-source = <2>;
			input-enable = <0>;
			output-enable = <1>;
			/delete-property/ output-low;
			/delete-property/ output-high;
			output-low;
			/delete-property/ bias-high-impedance;
			status = "okay";
		};

	mpp7 {
			bias-high-impedance;
			status = "okay";
		};

	mpp8 {
			bias-high-impedance;
			status = "okay";
		};
	};
};

&pm8994_gpios {
	default-state {
/* Gpio 1 and 3 is set on relevant usb-type-c */
/* at "kernel\arch\arm64\boot\dts\lge\msm8996-usb-typec-anx7418.dtsi" */
/* Must not define the gpios(gpio 20 and 21) on here */
	gpio2 {
			function = "normal";
			input-enable = <1>;
			output-enable = <0>;
			/delete-property/ output-low;
			/delete-property/ output-high;
			/delete-property/ bias-high-impedance;
			status = "okay";
		};

	gpio4 {
			bias-high-impedance;
			status = "okay";
		};

	gpio5 {
			bias-high-impedance;
			status = "okay";
		};

	gpio6 {
			function = "normal";
