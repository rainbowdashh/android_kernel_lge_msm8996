			/delete-property/ output-low;
			/delete-property/ output-high;
			/delete-property/ bias-high-impedance;
			status = "okay";
		};

	gpio5 {
			bias-high-impedance;
			status = "okay";
		};

	gpio6 {
			function = "normal";
			input-enable = <1>;
			output-enable = <0>;
			/delete-property/ output-low;
			/delete-property/ output-high;
			/delete-property/ bias-high-impedance;
			status = "okay";
		};

	gpio7 {
			bias-high-impedance;
			status = "okay";
		};

	gpio8 {
			function = "normal";
			input-enable = <1>;
			output-enable = <0>;
			/delete-property/ output-low;
			/delete-property/ output-high;
			/delete-property/ bias-high-impedance;
			status = "okay";
		};

	gpio9 {
			function = "normal";
			input-enable = <1>;
			output-enable = <0>;
			/delete-property/ output-low;
			/delete-property/ output-high;
			/delete-property/ bias-high-impedance;
			status = "okay";
		};

	gpio10 {
			function = "normal";
			input-enable = <1>;
			output-enable = <0>;
			/delete-property/ output-low;
