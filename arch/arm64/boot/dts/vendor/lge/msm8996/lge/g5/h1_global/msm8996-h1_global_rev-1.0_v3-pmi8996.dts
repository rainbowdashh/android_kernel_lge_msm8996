			status = "okay";
		};
	};
};

&pmi8994_gpios {
	default-state {
	gpio2 {
			bias-high-impedance;
			status = "okay";
		};

	gpio4 {
			bias-high-impedance;
			status = "okay";
		};

	gpio5 {
			bias-high-impedance;
			status = "okay";
		};

	gpio6 {
			bias-high-impedance;
			status = "okay";
		};

	gpio7 {
			bias-high-impedance;
			status = "okay";
		};

	gpio8 {
			bias-high-impedance;
			status = "okay";
		};

	gpio9 {
			bias-high-impedance;
			status = "okay";
		};

	gpio10 {
			bias-high-impedance;
			status = "okay";
		};
