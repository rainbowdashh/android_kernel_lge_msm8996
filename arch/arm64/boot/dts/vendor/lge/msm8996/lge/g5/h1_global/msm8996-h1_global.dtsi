#include "../common/pinctrl.dtsi"
#include "../common/misc.dtsi"
#include "../common/panel.dtsi"
#include "../common/touch-sic-lg494x.dtsi"
#include "../common/pm.dtsi"
#include "../common/sound.dtsi"
#include "../common/connectivity.dtsi"
#include "../common/hdmi.dtsi"
#include "../common/camera.dtsi"
#include "../common/usb-typec-anx7418.dtsi"
#include "../../common-nfc.dtsi"
#include "../../common-fingerprint.dtsi"
#include "../../common-various.dtsi"

/ {
	reserved-memory {
		crash_fb_mem: crash_fb_mem@c0100000 {
			linux,contiguous-region;
			reg = <0 0xc0100000 0 0xc00000>;
			label = "crash_fb_mem";
		};

		cont_splash_mem: cont_splash_mem@83401000 {
			status = "disabled";
		};

		/delete-node/ dfps_data_mem@83400000;
	};
};

&soc {
	wdog: qcom,wdt@9830000 {
		qcom,bark-time = <16000>;
	};

	crash_fb {
		compatible = "crash_fb";
		mem-addr = <0xc0100000>;
		mem-size = <0xc00000>;
	};

	bootlog {
		compatible = "bootlog";
	};

	/* stendro: this likely disabled in hw, disable here too */
	earjack-debugger {
		compatible = "serial,earjack-debugger";
		status = "disabled";
		interrupt-parent = <&tlmm>;
		serial,irq-gpio = <&tlmm 126 0>;
	};

	lge,monitor-thermal {
		compatible = "lge,monitor-thermal";
		status = "ok";
		lge,hot-poll-time = <10000>;
		lge,hot-crit-temp = <48>;
		lge,poll-time = <60000>;
		qcom,monitor-thermal-vadc = <&pm8994_vadc>;
	};

	apcc_cpr: cpr3-ctrl@99e8000 {
		thread@1 {
			apc1_vreg: regulator {
				qcom,cpr-closed-loop-voltage-fuse-adjustment =
					/* Speed bin 0 */
					<35000 35000 40000 (-30000) 70000>,
					<    0     0     0 (-70000) 30000>,
					<    0     0     0        0 30000>,
					<    0     0     0        0 30000>,
					<    0     0     0    10000 50000>,
					<    0     0     0    10000 40000>,
					<    0     0     0    10000 40000>,
					<    0     0     0        0 30000>,

					/* Speed bin 1 */
					<35000 35000 40000 (-30000) 70000>,
					<    0     0     0 (-70000) 30000>,
					<    0     0     0        0 30000>,
					<    0     0     0        0 30000>,
					<    0     0     0        0 30000>,
					<    0     0     0        0 30000>,
					<    0     0     0        0 30000>,
					<    0     0     0        0 30000>,

					/* Speed bin 2 */
					<35000 35000 40000 (-30000) 70000>,
					<    0     0     0 (-70000) 30000>,
					<    0     0     0        0 30000>,
					<    0     0     0        0 30000>,
					<    0     0     0        0 30000>,
					<    0     0     0        0 30000>,
					<    0     0     0        0 30000>,
					<    0     0     0        0 30000>,

					/* Speed bin 3 */
					<35000 35000 40000 (-30000) 70000>,
					<    0     0     0 (-70000) 30000>,
					<    0     0     0        0 30000>,
					<    0     0     0        0 30000>,
					<    0     0     0        0 30000>,
					<    0     0     0        0 30000>,
					<    0     0     0        0 30000>,
					<    0     0     0        0 30000>;
			};
		};

		thread@0 {
			apc0_pwrcl_vreg: regulator-pwrcl {
				qcom,cpr-closed-loop-voltage-fuse-adjustment =
					/* Speed bin 0 */
					<35000 35000 40000  40000   70000>,
					<20000 10000  5000 (-5000) 25000>,
					<20000 10000  5000 (-5000) 25000>,
					<20000 10000  5000 (-5000) 25000>,
					<20000 10000  5000 5000 35000>,
					<20000 10000  5000 5000 35000>,
					<20000 10000  5000 5000 35000>,
					<20000 10000  5000 (-5000) 25000>,

					/* Speed bin 1 */
					<35000 35000 40000  40000   70000>,
					<20000 10000  5000 (-5000) 25000>,
					<20000 10000  5000 (-5000) 25000>,
					<20000 10000  5000 (-5000) 25000>,
					<20000 10000  5000 (-5000) 25000>,
					<20000 10000  5000 (-5000) 25000>,
					<20000 10000  5000 (-5000) 25000>,
					<20000 10000  5000 (-5000) 25000>,

					/* Speed bin 2 */
					<35000 35000 40000  40000   70000>,
					<20000 10000  5000 (-5000) 25000>,
					<20000 10000  5000 (-5000) 25000>,
					<20000 10000  5000 (-5000) 25000>,
					<20000 10000  5000 (-5000) 25000>,
					<20000 10000  5000 (-5000) 25000>,
					<20000 10000  5000 (-5000) 25000>,
					<20000 10000  5000 (-5000) 25000>,

					/* Speed bin 3 */
					<35000 35000 40000  40000   70000>,
					<20000 10000  5000 (-5000) 25000>,
					<20000 10000  5000 (-5000) 25000>,
					<20000 10000  5000 (-5000) 25000>,
					<20000 10000  5000 (-5000) 25000>,
					<20000 10000  5000 (-5000) 25000>,
					<20000 10000  5000 (-5000) 25000>,
					<20000 10000  5000 (-5000) 25000>;
			};
		};
	};

	/*delete QCT finger */
	/delete-node/ qcom,qbt1000;

	/delete-node/ qcom,cnss;
	/delete-node/ qcom,wil6210;

};

&pm8994_vadc {
	chan@5 {
		label = "vcoin";
		reg = <5>;
		qcom,decimation = <0>;
		qcom,pre-div-channel-scaling = <1>;
		qcom,calibration-type = "absolute";
		qcom,scale-function = <0>;
		qcom,hw-settle-time = <0>;
		qcom,fast-avg-setup = <0>;
	};

	chan@7 {
		label = "vph_pwr";
		reg = <7>;
		qcom,decimation = <0>;
		qcom,pre-div-channel-scaling = <1>;
		qcom,calibration-type = "absolute";
		qcom,scale-function = <0>;
		qcom,hw-settle-time = <0>;
		qcom,fast-avg-setup = <0>;
	};

	chan@39 {
		label = "usb_id_lv";
		reg = <0x39>;
		qcom,decimation = <0>;
		qcom,pre-div-channel-scaling = <0>;
		qcom,calibration-type = "ratiometric";
		qcom,scale-function = <0>;
		qcom,hw-settle-time = <5>;
		qcom,fast-avg-setup = <0>;
	};

        chan@72 {
		label = "xo_therm";
		reg = <0x72>;
		qcom,decimation = <0>;
		qcom,pre-div-channel-scaling = <0>;
		qcom,calibration-type = "ratiometric";
		qcom,scale-function = <4>;
		qcom,hw-settle-time = <2>;
		qcom,fast-avg-setup = <0>;
		status = "ok";
	};

	chan@73 {
		label = "bd_therm_1";
		reg = <0x73>;
		qcom,decimation = <0>;
		qcom,pre-div-channel-scaling = <0>;
		qcom,calibration-type = "ratiometric";
		qcom,scale-function = <2>;
		qcom,hw-settle-time = <2>;
		qcom,fast-avg-setup = <0>;
		status = "ok";
	};

	chan@74 {
		label = "bd_therm_2";
		reg = <0x74>;
		qcom,decimation = <0>;
		qcom,pre-div-channel-scaling = <0>;
		qcom,calibration-type = "ratiometric";
		qcom,scale-function = <2>;
		qcom,hw-settle-time = <2>;
		qcom,fast-avg-setup = <0>;
		status = "ok";
	};

	chan@75 {
		label = "pa_therm0";
		reg = <0x75>;
		qcom,decimation = <0>;
		qcom,pre-div-channel-scaling = <0>;
		qcom,calibration-type = "ratiometric";
		qcom,scale-function = <2>;
		qcom,hw-settle-time = <2>;
		qcom,fast-avg-setup = <0>;
		status = "ok";
	};

	chan@76 {
		label = "pcb_rev";
		reg = <0x76>;
		qcom,decimation = <0>;
		qcom,pre-div-channel-scaling = <0>;
		qcom,calibration-type = "ratiometric";
		qcom,scale-function = <0>;
		qcom,hw-settle-time = <1>;
		qcom,fast-avg-setup = <0>;
	};

	chan@77 {
		label = "pa_therm1";
		reg = <0x77>;
		qcom,decimation = <0>;
		qcom,pre-div-channel-scaling = <0>;
		qcom,calibration-type = "ratiometric";
		qcom,scale-function = <2>;
		qcom,hw-settle-time = <2>;
		qcom,fast-avg-setup = <0>;
		status = "disabled";
	};

	chan@78 {
		label = "acc_nt";
		reg = <0x78>;
		qcom,decimation = <0>;
		qcom,pre-div-channel-scaling = <0>;
		qcom,calibration-type = "ratiometric";
		qcom,scale-function = <0>;
		qcom,hw-settle-time = <5>;
		qcom,fast-avg-setup = <0>;
	};

	chan@79 {
		label = "usb_id_lv_pu";
		reg = <0x79>;
		qcom,decimation = <0>;
		qcom,pre-div-channel-scaling = <0>;
		qcom,calibration-type = "ratiometric";
		qcom,scale-function = <0>;
		qcom,hw-settle-time = <5>;
		qcom,fast-avg-setup = <0>;
	};

	chan@7c {
		label = "xo_therm_buf";
		reg = <0x7c>;
		qcom,decimation = <0>;
		qcom,pre-div-channel-scaling = <0>;
		qcom,calibration-type = "ratiometric";
		qcom,scale-function = <4>;
		qcom,hw-settle-time = <2>;
		qcom,fast-avg-setup = <0>;
		status = "disabled";
	};
};

&pm8994_adc_tm {
	chan@72 {
		label = "xo_therm";
		reg = <0x72>;
		qcom,decimation = <0>;
		qcom,pre-div-channel-scaling = <0>;
		qcom,calibration-type = "ratiometric";
		qcom,scale-function = <4>;
		qcom,hw-settle-time = <2>;
		qcom,fast-avg-setup = <0>;
		qcom,btm-channel-number = <0x72>;
		qcom,thermal-node;
		status = "ok";
	};

	chan@73 {
		label = "bd_therm_1";
		reg = <0x73>;
		qcom,decimation = <0>;
		qcom,pre-div-channel-scaling = <0>;
		qcom,calibration-type = "ratiometric";
		qcom,scale-function = <2>;
		qcom,hw-settle-time = <2>;
		qcom,fast-avg-setup = <0>;
		qcom,btm-channel-number = <0x48>;
		qcom,thermal-node;
		status = "ok";
	};

	chan@74 {
		label = "bd_therm_2";
		reg = <0x74>;
		qcom,decimation = <0>;
		qcom,pre-div-channel-scaling = <0>;
		qcom,calibration-type = "ratiometric";
		qcom,scale-function = <2>;
		qcom,hw-settle-time = <2>;
		qcom,fast-avg-setup = <0>;
