			power-source = <2>;
			function = "normal";
			/delete-property/ output-high;
			/delete-property/ output-low;
			output-low;
			qcom,drive-strength = <1>;
			/delete-property/ bias-high-impedance;
			status = "okay";
		};

		gpio4 { /* GPIO 4 - EIS_LDO_EN */
			input-enable = <0>;
			output-enable;
			/delete-property/ bias-disable;
			/delete-property/ bias-pull-down;
			/delete-property/ qcom,pull-up-strength;
			bias-pull-down;
			power-source = <2>;
			function = "normal";
			/delete-property/ output-high;
			/delete-property/ output-low;
			output-low;
			qcom,drive-strength = <1>;
			/delete-property/ bias-high-impedance;
			status = "okay";
		};

		gpio5 { /* GPIO 5 - NC */
			input-enable = <0>;
			output-enable;
			/delete-property/ bias-disable;
			/delete-property/ bias-pull-down;
			/delete-property/ qcom,pull-up-strength;
			bias-disable;
			/delete-property/ drive-push-pull;
			/delete-property/ drive-open-drain;
			/delete-property/ drive-open-source;
			drive-push-pull;
			power-source = <2>;
			function = "normal";
			/delete-property/ output-high;
			/delete-property/ output-low;
			output-low;
			qcom,drive-strength = <2>;
			bias-high-impedance;
			status = "okay";
		};

		gpio6 { /* GPIO 6 - NC */
			input-enable = <0>;
			output-enable;
			/delete-property/ bias-disable;
			/delete-property/ bias-pull-down;
			/delete-property/ qcom,pull-up-strength;
			bias-pull-down;
			power-source = <2>;
			function = "normal";
			/delete-property/ output-high;
			/delete-property/ output-low;
			output-low;
			qcom,drive-strength = <1>;
			bias-high-impedance;
			status = "okay";
		};

		gpio7 { /* GPIO 7 - NC */
			input-enable = <1>;
			output-enable;
			/delete-property/ bias-disable;
			/delete-property/ bias-pull-down;
			/delete-property/ qcom,pull-up-strength;
			bias-pull-down;
			/delete-property/ drive-push-pull;
			/delete-property/ drive-open-drain;
			/delete-property/ drive-open-source;
			drive-open-source;
			power-source = <2>;
			function = "normal";
			/delete-property/ output-high;
			/delete-property/ output-low;
			output-low;
			qcom,drive-strength = <2>;
			bias-high-impedance;
			status = "okay";
		};

		gpio8 { /* GPIO 8 - NC */
			input-enable = <0>;
			output-enable;
			/delete-property/ bias-disable;
			/delete-property/ bias-pull-down;
			/delete-property/ qcom,pull-up-strength;
			qcom,pull-up-strength = <0>;
			power-source = <2>;
			function = "normal";
			/delete-property/ output-high;
			/delete-property/ output-low;
			output-high;
			qcom,drive-strength = <1>;
			bias-high-impedance;
			status = "okay";
		};

		gpio9 { /* GPIO 9 - NC */
			input-enable = <0>;
			output-enable;
			/delete-property/ bias-disable;
			/delete-property/ bias-pull-down;
			/delete-property/ qcom,pull-up-strength;
			bias-pull-down;
			power-source = <2>;
			function = "normal";
			/delete-property/ output-high;
			/delete-property/ output-low;
			output-low;
			qcom,drive-strength = <1>;
			bias-high-impedance;
			status = "okay";
		};

		gpio10 { /* GPIO 10 - NC */
			input-enable = <0>;
			output-enable;
			/delete-property/ bias-disable;
			/delete-property/ bias-pull-down;
			/delete-property/ qcom,pull-up-strength;
			bias-pull-down;
			power-source = <2>;
			function = "normal";
			/delete-property/ output-high;
			/delete-property/ output-low;
			output-low;
			qcom,drive-strength = <1>;
