config SND_SOC_MSM8996
	bool "MSM8996 downstream audio"
	depends on ARCH_MSM8996 && SND_SOC && RPMSG_QCOM_SMD
	select SLIMBUS
	select SLIMBUS_MSM_NGD
	select SND_SOC_COMPRESS
	select SND_HWDEP
	select SND_DYNAMIC_MINORS
	select REGMAP
	select REGMAP_I2C
	help
	  Audio support for MSM8996 devices using the downstream APR firmware
	  interface and WCD9335 codec.

