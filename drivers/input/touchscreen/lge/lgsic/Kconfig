	bool "LG V20 LG4945 touch controller"
	depends on LGE_TOUCH_CORE && MACH_MSM8996_ELSA

config LGE_TOUCH_LGSIC_SW49407
	bool "LG V20 SW49407 touch controller"
	depends on LGE_TOUCH_CORE && MACH_MSM8996_ELSA
